# One-shot variant, driven by kube-secret-gateway-agent-once.timer. Bundle
# intervals in the configuration are ignored; systemd owns the schedule.
[Unit]
Description=Synchronize kube-secret-gateway bundles once
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kube-secret-gateway-agent -config /etc/kube-secret-gateway-agent/config.yaml -once
StateDirectory=kube-secret-gateway-agent
StateDirectoryMode=0700
NoNewPrivileges=true
