# Long-lived service: each exposure is synced on its own interval.
# The configuration is read at startup only; restart after changing it.
[Unit]
Description=Synchronize kube-secret-gateway exposures
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/kube-secret-gateway-agent -config /etc/kube-secret-gateway-agent/config.yaml
Restart=on-failure
RestartSec=30s

StateDirectory=kube-secret-gateway-agent
StateDirectoryMode=0700

# The process needs to read the credentials, write the installed files and
# reload other units. It needs nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
